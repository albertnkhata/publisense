rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Feedback items: Publicly readable by all builders; creatable & updatable
    match /feedback/{feedbackId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Companies: Publicly readable by all; updatable for claims & roster additions
    match /companies/{companyId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Products: Publicly readable; updatable when subsumed or followed
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Notifications: Publicly readable / writable for user alerts
    match /notifications/{notificationId} {
      allow get, list, create, update, delete: if true;
    }

    // Waitlist submissions for Coming Soon launch
    match /waitlist/{waitlistId} {
      allow get, list, create, update: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}
