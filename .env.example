# Supabase Configuration
# When left blank, Publisense automatically runs in Local Persistence Mode
# using an in-browser relational store seeded with sample products, orgs, and feedback.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Auth surface flags.
#
# VITE_AUTH_MAGIC_LINK turns on the Magic Link tab. Only set it to "true" once
# SMTP is configured on the Supabase project AND a real sign-in email has been
# received — otherwise the tab invites users into a flow that cannot deliver.
# The AuthModal reads Google/GitHub availability from /auth/v1/settings at
# runtime, so those buttons need no flag: they appear when the provider is
# enabled in the project.
VITE_AUTH_MAGIC_LINK="false"

# VITE_SHOW_DEMO_PERSONAS exposes the dev persona switcher, which renders
# admin/maintainer views with no Supabase session. Leave unset in production.
# It is also force-enabled by `vite dev`.
VITE_SHOW_DEMO_PERSONAS="false"

