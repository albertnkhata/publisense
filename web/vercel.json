{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/b/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=board&key=:key"
    },
    {
      "source": "/h/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=hub&key=:key"
    },
    {
      "source": "/post/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=post&key=:key"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/unsubscribe",
      "destination": "/index.html"
    },
    {
      "source": "/auth/reset",
      "destination": "/index.html"
    },
    {
      "source": "/b/:board",
      "destination": "/index.html"
    },
    {
      "source": "/b/:board/manage",
      "destination": "/index.html"
    },
    {
      "source": "/h/:hub",
      "destination": "/index.html"
    },
    {
      "source": "/h/:hub/manage",
      "destination": "/index.html"
    },
    {
      "source": "/post/:id",
      "destination": "/index.html"
    },
    {
      "source": "/u/:handle",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:page",
      "destination": "/index.html"
    },
    {
      "source": "/dev/kit",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
