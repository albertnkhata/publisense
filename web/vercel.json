{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "rewrites": [
    {
      "source": "/b/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=board&key=:key"
    },
    {
      "source": "/h/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=hub&key=:key"
    },
    {
      "source": "/post/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|whatsapp|slack|discord|telegram|linkedin|embedly|pinterest|skype|vkshare|applebot|mastodon|bluesky).*"
        }
      ],
      "destination": "/api/share?kind=post&key=:key"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
